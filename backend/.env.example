# Copie este arquivo para .env e preencha os valores. O .env NUNCA vai para o Git.

# Porta onde a API roda no seu computador
PORT=3000

# String do Supabase: painel > Connect > Session pooler.
# Troque [SENHA] pela senha do banco (caracteres especiais como & # ? @ precisam ser codificados).
# Nao coloque ?sslmode= no final: o SSL e configurado em src/config/db.js.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@[HOST-DO-POOLER]:5432/postgres

# true para o Supabase. Use false apenas se for testar com um PostgreSQL local.
DB_SSL=true

# Segredo usado para assinar os tokens de login. Use um texto longo e aleatorio.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_EM=8h

# Enderecos do front-end liberados no CORS, separados por virgula.
# Deixe em branco para liberar qualquer origem durante o desenvolvimento.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
